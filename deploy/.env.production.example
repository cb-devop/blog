# ============================================================
# PremiumBlog — Production environment template
# Copy this file to deploy/.env.production and fill in the values:
#   cp deploy/.env.production.example deploy/.env.production
#   nano deploy/.env.production
# IMPORTANT: deploy/.env.production contains SECRETS — never commit it.
# ============================================================

# --- Domains ---
# Frontend (public blog) domain
FRONTEND_URL=https://blog.example.com
# Admin panel domain
ADMIN_URL=https://admin.example.com

# --- Frontend app (next) ---
# Server-side fetches to the admin API (contact, subscribe, comments routes)
ADMIN_API_URL=https://admin.example.com
# Client-side fetches to the admin API (blog posts on the public site).
# MUST be set before `next build` because it gets inlined into the client bundle.
NEXT_PUBLIC_ADMIN_API_URL=https://admin.example.com

# --- Admin app (next) ---
# Strong random secret for JWT tokens. Generate with:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
# Password for the initial admin user seed (set before first deploy)
ADMIN_SEED_PASSWORD=CHANGE_ME_admin_password
# Used for CORS + maintenance-mode propagation to the frontend
NEXT_PUBLIC_FRONTEND_URL=https://blog.example.com

# --- Backend (Django) ---
# Generate with: openssl rand -hex 32  (or use `python -c "import secrets; print(secrets.token_urlsafe(50))"`)
DJANGO_SECRET_KEY=CHANGE_ME_django_secret_key
# Password for the Django superuser seed
DJANGO_SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password
# Must be False in production!
DJANGO_DEBUG=False
# Comma-separated hosts that may serve this app
DJANGO_ALLOWED_HOSTS=blog.example.com,admin.example.com
# Comma-separated origins allowed to call the Django API (optional)
DJANGO_CORS_ORIGINS=https://blog.example.com,https://admin.example.com
