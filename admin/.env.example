# ------------------------------------------------------------------
# Admin app environment variables
# Copy this file to `.env.local` for local dev:
#   cp .env.example .env.local
# Then fill in your values. `.env*.local` is gitignored.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# AI Writer — API key
# ------------------------------------------------------------------
# The AI Writer reads its key from an environment variable FIRST, and
# only falls back to the key saved in admin/data/settings.json.
#
# Use AI_API_KEY for any provider (Gemini, OpenAI, OpenRouter, ...),
# or the provider-specific GEMINI_API_KEY for the default Gemini provider.
# If both are set, AI_API_KEY wins.
AI_API_KEY=
# GEMINI_API_KEY=

# ------------------------------------------------------------------
# Other commonly used variables (optional, already have defaults)
# ------------------------------------------------------------------
# JWT_SECRET=generate-a-strong-random-secret-here
# FRONTEND_URL=http://localhost:3000
# NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
